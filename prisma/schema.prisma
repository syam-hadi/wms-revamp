generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
}

enum UserType {
  EMPLOYEE
  VENDOR
  CUSTOMER
}

model Config {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @db.VarChar(20)
  name        String  @db.VarChar(150)
  description String? @db.VarChar(100)
  configGroup String  @map("config_group") @db.VarChar(50)
  optionType  String  @map("option_type") @db.VarChar(20)
  status      Status  @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@unique([configGroup, code])
  @@index([configGroup, status, deletedAt])
  @@map("m_configs")
}

model Country {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(5)
  name String @db.VarChar(150)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  provinces Province[]

  @@map("m_countries")
}

model Province {
  id        String @id @default(uuid()) @db.Uuid
  countryId String @map("m_country_id") @db.Uuid
  code      String @db.VarChar(5)
  name      String @db.VarChar(150)

  country Country @relation(fields: [countryId], references: [id])
  cities  City[]

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@unique([countryId, code])
  @@index([countryId, deletedAt])
  @@map("m_provinces")
}

model City {
  id         String @id @default(uuid()) @db.Uuid
  provinceId String @map("m_province_id") @db.Uuid
  code       String @db.VarChar(20)
  name       String @db.VarChar(150)

  province Province @relation(fields: [provinceId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@unique([provinceId, code])
  @@index([provinceId, deletedAt])
  @@map("m_cities")
}

model Bank {
  id        String @id @default(uuid()) @db.Uuid
  code      String @unique @db.VarChar(20)
  shortName String @unique @map("short_name") @db.VarChar(150)
  name      String @unique @db.VarChar(150)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@map("m_banks")
}

model Tax {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(20)
  name        String  @unique @db.VarChar(150)
  description String? @db.VarChar(100)
  value       Decimal @db.Decimal(12, 4)
  flagType    Boolean @map("flag_type")
  coa         String? @db.VarChar(20)
  taxCode     String? @map("tax_code") @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@map("m_taxes")
}
